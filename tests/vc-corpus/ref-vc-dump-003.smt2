(set-option :produce-unsat-cores true)
(declare-const v_0 Int)
(declare-const v_1 Int)
(declare-const sel_1 Bool)
(declare-const sel_2 Bool)
(declare-const sel_3 Bool)
(declare-const sel_4 Bool)
(declare-const sel_5 Bool)
(assert (=> sel_1 (= (>= 3 3) true)))
(assert (=> sel_2 (= (>= v_0 3) true)))
(assert (=> sel_3 (= (= v_0 3) true)))
(assert (=> sel_4 (= (> 1 0) true)))
(assert (=> sel_5 (= (> v_1 0) true)))
(assert (not (= (> v_1 0) true)))
(check-sat-assuming (sel_1 sel_2 sel_3 sel_4 sel_5))
(get-unsat-core)
