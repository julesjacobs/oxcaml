 "mechanisms": [
  {
   "id": "interfaces",
   "name": "Abstract interfaces",
   "summary": "Hide representations while exporting observations and laws for client proofs.",
   "demos": [
    "flat-hash-table",
    "hindley-milner",
    "quicksort",
    "merge-sort",
    "avl-sets",
    "binary-search",
    "functional-queue",
    "sparse-arrays"
   ]
  },
  {
   "id": "refinements",
   "name": "Refinements",
   "summary": "Express preconditions, postconditions, and datatype invariants in types.",
   "demos": [
    "quicksort",
    "merge-sort",
    "avl-sets",
    "binary-search",
    "functional-queue"
   ]
  },
  {
   "id": "runtime-checks",
   "name": "Runtime checks and testing",
   "summary": "Check refinements with `assume_`, then use the facts in proofs and executable tests.",
   "demos": [
    "regex-automata",
    "merge-sort",
    "binary-search"
   ]
  },
  {
   "id": "heap-ownership",
   "name": "Heap ownership and framing",
   "summary": "Track permission to read and update a heap fragment while preserving the rest.",
   "demos": [
    "flat-hash-table",
    "hindley-milner",
    "online-union-find",
    "lists-trees",
    "rings",
    "reference-locks"
   ]
  },
  {
   "id": "borrowing",
   "name": "Borrowing with prophecies",
   "summary": "Name a loan’s eventual contents and relate them to the owner returned afterward.",
   "demos": [
    "quicksort"
   ]
  },
  {
   "id": "concurrency",
   "name": "Ownership transfer and parallelism",
   "summary": "Transfer exclusive resources through channels or give parallel callbacks disjoint slices.",
   "demos": [
    "quicksort",
    "one-shot-channels"
   ]
  },
  {
   "id": "atomics",
   "name": "Atomic invariants",
   "summary": "Exchange protected resources at atomic events while maintaining a shared invariant.",
   "demos": [
    "one-shot-channels",
    "reference-locks"
   ]
  },
  {
   "id": "time-credits",
   "name": "Time credits and amortized analysis",
   "summary": "Use consumable ghost budgets and potentials to bound charged operations.",
   "demos": [
    "online-union-find",
    "merge-sort"
   ]
  },
  {
   "id": "definitions",
   "name": "Definitions and induction",
   "summary": "Unfold equations with `[@def]` and prove recursive properties by induction.",
   "demos": [
    "regex-automata",
    "merge-sort",
    "avl-sets",
    "functional-queue",
    "sparse-arrays",
    "constant-folding"
   ]
  },
  {
   "id": "totality",
   "name": "Totality",
   "summary": "Check termination and definedness for specification functions and erasable proofs.",
   "demos": [
    "hindley-milner",
    "quicksort",
    "regex-automata",
    "binary-search",
    "constant-folding"
   ]
  },
  {
   "id": "ghost",
   "name": "Ghost code and erasure",
   "summary": "Use checked proofs without executing them; erase evidence from runtime representations.",
   "demos": [
    "hindley-milner",
    "constant-folding"
   ]
  },
  {
   "id": "inductive-definitions",
   "name": "Inductive definitions",
   "future": true,
   "summary": "Relations defined by inference rules, written as ordinary variants whose fields carry the premises as refinements. Today such relations are written by hand as a derivation datatype with a validity predicate; this needs fields whose refinements mention earlier fields.",
   "demos": []
  }
 ],
