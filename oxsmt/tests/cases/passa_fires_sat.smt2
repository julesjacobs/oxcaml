(set-info :smt-lib-version 2.6)
(set-logic QF_UF)
(set-info :status sat)
(declare-sort U 0)
(declare-fun a () U)
(declare-fun c () U)
(declare-fun e () U)
(declare-fun g () U)
(declare-fun h () U)
(declare-fun p () Bool)
(assert (and (or (and (= g h) (ite p (= a c) (= a e))) (and (= g h) (= a e))) (not (= a e))))
(check-sat)
