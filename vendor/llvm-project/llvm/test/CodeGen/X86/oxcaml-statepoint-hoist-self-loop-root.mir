# RUN: llc -o - %s -run-pass fixup-statepoint-caller-saved -verify-machineinstrs | FileCheck %s

--- |
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-pc-linux-gnu"

  declare oxcaml_fpcc void @callee(i64, i64, i64) gc "oxcaml"

  define oxcaml_fpcc void @test_self_loop_root(i64 %p) gc "oxcaml" {
    ret void
  }

  define oxcaml_fpcc void @test_self_loop_root_reg_redefined(i64 %p) gc "oxcaml" {
    ret void
  }

  define oxcaml_fpcc void @test_self_loop_root_slot_loaded(i64 %p) gc "oxcaml" {
    ret void
  }
...
---
name:            test_self_loop_root
alignment:       16
tracksRegLiveness: true
liveins:
  - { reg: '$rdi', virtual-reg: '' }
  - { reg: '$r14', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
  - { reg: '$rax', virtual-reg: '' }
frameInfo:
  hasCalls:        true
  maxCallFrameSize: 4294967295
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 8, alignment: 8,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $rdi, $r14, $r15, $rax

    ; CHECK-LABEL: name: test_self_loop_root
    ; CHECK: bb.0:
    ; CHECK: MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
    ; CHECK: JMP_1 %bb.1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $rdi, $r14, $r15, $rax

    ; CHECK: bb.1:
    ; CHECK-NOT: MOV64mr %stack.0
    ; CHECK: STATEPOINT 0, 0, 3, @callee, $r14, $r15, $rax, 2, 104
    ; CHECK: $rdi = MOV64rm %stack.0
    ; CHECK-NOT: MOV64mr %stack.0
    ; CHECK: bb.2:
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    STATEPOINT 0, 0, 3, @callee, $r14, $r15, $rax, 2, 104, 2, 0, 2, 0, 2, 1, 1, 8, %stack.0, 0, 2, 0, 2, 1, 0, 0, csr_64_oxcaml_withfp, implicit-def $rsp, implicit-def $ssp, implicit-def $r14, implicit-def $r15, implicit-def $rax :: (load (s64) from %stack.0)
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    TEST64rr $rax, $rax, implicit-def $eflags
    JCC_1 %bb.1, 7, implicit killed $eflags
    JMP_1 %bb.2

  bb.2:
    liveins: $rdi

    RET 0
...
---
name:            test_self_loop_root_reg_redefined
alignment:       16
tracksRegLiveness: true
liveins:
  - { reg: '$rdi', virtual-reg: '' }
  - { reg: '$rsi', virtual-reg: '' }
  - { reg: '$r14', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
  - { reg: '$rax', virtual-reg: '' }
frameInfo:
  hasCalls:        true
  maxCallFrameSize: 4294967295
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 8, alignment: 8,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $rdi, $rsi, $r14, $r15, $rax

    ; CHECK-LABEL: name: test_self_loop_root_reg_redefined
    ; CHECK: bb.0:
    ; CHECK-NOT: MOV64mr %stack.0
    ; CHECK: JMP_1 %bb.1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $rdi, $rsi, $r14, $r15, $rax

    ; CHECK: bb.1:
    ; CHECK: $rdi = COPY $rsi
    ; CHECK: MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
    ; CHECK: STATEPOINT 0, 0, 3, @callee, $r14, $r15, $rax, 2, 104
    $rdi = COPY $rsi
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    STATEPOINT 0, 0, 3, @callee, $r14, $r15, $rax, 2, 104, 2, 0, 2, 0, 2, 1, 1, 8, %stack.0, 0, 2, 0, 2, 1, 0, 0, csr_64_oxcaml_withfp, implicit-def $rsp, implicit-def $ssp, implicit-def $r14, implicit-def $r15, implicit-def $rax :: (load (s64) from %stack.0)
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    TEST64rr $rax, $rax, implicit-def $eflags
    JCC_1 %bb.1, 7, implicit killed $eflags
    JMP_1 %bb.2

  bb.2:
    liveins: $rdi

    RET 0
...
---
name:            test_self_loop_root_slot_loaded
alignment:       16
tracksRegLiveness: true
liveins:
  - { reg: '$rdi', virtual-reg: '' }
  - { reg: '$r14', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
  - { reg: '$rax', virtual-reg: '' }
frameInfo:
  hasCalls:        true
  maxCallFrameSize: 4294967295
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 8, alignment: 8,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $rdi, $r14, $r15, $rax

    ; CHECK-LABEL: name: test_self_loop_root_slot_loaded
    ; CHECK: bb.0:
    ; CHECK-NOT: MOV64mr %stack.0
    ; CHECK: JMP_1 %bb.1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $rdi, $r14, $r15, $rax

    ; CHECK: bb.1:
    ; CHECK: $rcx = MOV64rm %stack.0
    ; CHECK: MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
    ; CHECK: STATEPOINT 0, 0, 3, @callee, $r14, $r15, $rax, 2, 104
    $rcx = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    STATEPOINT 0, 0, 3, @callee, $r14, $r15, $rax, 2, 104, 2, 0, 2, 0, 2, 1, 1, 8, %stack.0, 0, 2, 0, 2, 1, 0, 0, csr_64_oxcaml_withfp, implicit-def $rsp, implicit-def $ssp, implicit-def $r14, implicit-def $r15, implicit-def $rax :: (load (s64) from %stack.0)
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    TEST64rr $rax, $rax, implicit-def $eflags
    JCC_1 %bb.1, 7, implicit killed $eflags
    JMP_1 %bb.2

  bb.2:
    liveins: $rdi

    RET 0
...
