# vox stdlib module manifest — module : deps : wave
# Read by the integrator harnesses; the v1.5 polymorphic wave appends below.
# deps = space-separated dependency modules (cmi + VoxSig olean staged before verify).

# --- v1 core (waves 1-2) ---
Vlist     : Voption    : 1   # + HOF surface (WP-0): map/filter/fold_left/for_all/exists/rev/nth are LEAF; find_opt returns Voption.t -> adds the Voption dep (VoxSig_Vlist imports VoxSig_Voption transitively)
Voption   :            : 1
Vresult   :            : 1
Vint      :            : 1
Viarray   :            : 1
Vset_bst  :            : 1
Vmap      : Vlist Voption : 1   # keys enumerates into a Vlist; Voption staged transitively (VoxSig_Vlist now imports VoxSig_Voption via Vlist.find_opt)
Vset      : Vset_bst Vlist Voption : 2   # face over backend; elements enumerates into a Vlist; Voption staged transitively (via Vlist.find_opt's VoxSig)

# --- v1.5 polymorphic wave (Vplist / Vpmap / Vpset) — SLOT, per poly study ---
# check_poly.sh will verify these against v1 artifacts + the ORDERED/EQ element
# signature; append here as they land.
Vplist     :            : 3   # element-poly 'a list; LEAF (no deps); parameterized PList model; unspecced empty (F-B2), no bool mem (F-B3)
Vpset      :            : 3   # order-free 'a set; LEAF (no deps); C-1, RELATIONAL membership only (no bool mem/remove — DecidableEq at S_param)
Vpmap      :            : 3   # 'v-valued int-keyed map; LEAF (empty/is_empty/find/add/remove, no keys op → no Vlist/Vplist dep)

# --- capstone: higher-order relational specs (task #68 lambda reflection) ---
Vrel       :            : 4   # relational HOF (iter/map/fold/fold3/filter/compose2); LEAF (own ilist); relation = dependent fn-type param supplied as call-site lambda or [@@vox.reflect] value; IntRel/IntPred/IntRel3 abbrev, lifting defs expose, toNat bridges public, listRel_len obligation; EXACT-output law family (relIter_succ_exact, relFold_{sum,count}_exact) as .mli-only public theorems (graph-relation completeness); fold3 = element-aware ternary-relation fold (relFold + il_sum)
