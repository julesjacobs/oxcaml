; Test-only. Depends on oxsmt_solver + oxsmt_certificate (both stdlib-only), honoring the
; dependency firewall (I3). cert_emit_test = step-1 emission wiring; checker_test = step-2
; replay checker (VALID on honest streams, INVALID/UNSUPPORTED on corrupted ones). Run via
; `make cert-test` / `make checker-test`.

(executable
 (name cert_emit_test)
 (modules cert_emit_test)
 (libraries oxsmt_solver oxsmt_certificate))

(executable
 (name checker_test)
 (modules checker_test)
 (libraries
  oxsmt_core
  oxsmt_preprocess
  oxsmt_lia
  oxsmt_solver
  oxsmt_interface
  oxsmt_certificate))

; lra_cert_test = Real (LRA) certificate soundness under the OXSMT_LRA flip (riders
; #162/#134). Links unix so it can set OXSMT_LRA before the lazy Lra_config gate is forced.
(executable
 (name lra_cert_test)
 (modules lra_cert_test)
 (libraries unix oxsmt_core oxsmt_solver oxsmt_interface oxsmt_certificate))
